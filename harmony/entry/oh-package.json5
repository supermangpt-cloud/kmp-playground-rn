{
  "name": "entry",
  "version": "1.0.0",
  "description": "HarmonyOS entry module: shows the native splash and mounts the RN surface.",
  "main": "",
  "author": "",
  "license": "",
  "dependencies": {
    // Install from the ohpm registry instead of the official tester's local
    // file: path; this repository is a standalone app, not a checkout of
    // ohos_react_native.
    "@rnoh/react-native-openharmony": "0.72.140",
    // HarmonyOS adaptation of react-native-webview. It is not autolinked, so
    // the prebuilt har from node_modules is linked manually here.
    "@react-native-oh-tpl/react-native-webview": "file:../../node_modules/@react-native-oh-tpl/react-native-webview/harmony/rn_webview.har",
    // HarmonyOS adaptation of react-native-svg, the renderer behind
    // react-native-qrcode-svg. Same manual link: its har carries the C++
    // CAPI component implementations and the C++ turbo modules, so only the
    // CMake/PackageProvider.cpp side is registered.
    "@react-native-oh-tpl/react-native-svg": "file:../../node_modules/@react-native-oh-tpl/react-native-svg/harmony/svg.har",
    // HarmonyOS photo picker used by the platform-capability page's album
    // decode. Its har only provides an ArkTS turbo module, so the app adds the
    // C++ method map it needs under the CAPI architecture
    // (ImagePickerTurboModule.h).
    "@react-native-oh-tpl/react-native-image-picker": "file:../../node_modules/@react-native-oh-tpl/react-native-image-picker/harmony/image_picker.har",
    // HarmonyOS key/value storage used by the platform-capability page's
    // local-storage round trip. The har ships an ArkTS any-thread turbo module
    // plus the generated C++ method map for the CAPI architecture.
    "@react-native-oh-tpl/async-storage": "file:../../node_modules/@react-native-oh-tpl/async-storage/harmony/async_storage.har",
    // HarmonyOS clipboard used by the platform-capability page's clipboard
    // row. Same shape as async-storage: ArkTS turbo module plus a C++ method
    // map, both linked by hand.
    "@react-native-oh-tpl/clipboard": "file:../../node_modules/@react-native-oh-tpl/clipboard/harmony/clipboard.har",
    // HarmonyOS adaptation of react-native-ble-plx, backing the
    // platform-capability page's 蓝牙 LE card. Its har is ArkTS-only (the
    // `BlePlx` turbo module over @ohos.bluetooth.ble), so it is registered from
    // PackageProvider.ets and needs no CMake entry.
    "@react-native-oh-tpl/react-native-ble-plx": "file:../../node_modules/@react-native-oh-tpl/react-native-ble-plx/harmony/rn_bleplx.har"
  }
}
