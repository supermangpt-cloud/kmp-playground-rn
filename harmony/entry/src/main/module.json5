{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        // The platform-capability page's 网络状态 row reads the default network
        // and its bearer types through @ohos.net.connection. GET_NETWORK_INFO is
        // a normal-level system_grant permission, so the app holds it on install
        // and no runtime dialog is involved.
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        // The self-drawn scan page (`pages/ScanPage`) previews the back camera
        // through Scan Kit's customScan. CAMERA is a user_grant permission, so
        // the page asks at runtime and the reason string is shown in the
        // system dialog.
        "name": "ohos.permission.CAMERA",
        "reason": "$string:camera_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        // The platform-capability page's 存储目录 card reads the public
        // Download directory. Both public-directory permissions are
        // user_grant + normal and are only requested by the card's 刷新 press;
        // opening the page reads without showing a dialog.
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
        "reason": "$string:download_directory_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        // Same card, public Documents directory.
        "name": "ohos.permission.READ_WRITE_DOCUMENTS_DIRECTORY",
        "reason": "$string:documents_directory_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        // The platform-capability page's 震动 / 触觉 row starts a short
        // vibration through @ohos.vibrator. VIBRATE is a normal-level
        // system_grant permission, so it is held on install and produces no
        // runtime dialog.
        "name": "ohos.permission.VIBRATE"
      },
      {
        // The 动态权限 card's microphone row. It is a user_grant permission,
        // so the row's 申请 button is what shows the system dialog; the reason
        // appears in it.
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:microphone_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        // The 动态权限 card's location row asks for both accuracy levels (the
        // user may grant only the approximate one).
        "name": "ohos.permission.LOCATION",
        "reason": "$string:location_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:location_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        // The 动态权限 card's calendar row.
        "name": "ohos.permission.READ_CALENDAR",
        "reason": "$string:calendar_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        // The 动态权限 card's Bluetooth row.
        "name": "ohos.permission.ACCESS_BLUETOOTH",
        "reason": "$string:bluetooth_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        // Saving the generated QR code writes a PNG into the system album. On
        // HarmonyOS createAsset needs WRITE_IMAGEVIDEO, a user_grant permission
        // whose availableLevel is system_basic, so a normal app receives it
        // only through the ACL in the signing profile. Declaring it here is
        // what makes the runtime request possible at all; the ACL itself stays
        // out of the repository with the rest of the signing material.
        "name": "ohos.permission.WRITE_IMAGEVIDEO",
        "reason": "$string:save_image_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        // RNOH's dev menu registers a shake detector (debug builds) on the
        // accelerometer; without this normal-level permission it logs an error
        // and shake-to-open-dev-menu stays disabled. It is unrelated to the
        // scan page.
        "name": "ohos.permission.ACCELEROMETER"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "visible": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ]
  }
}
