/**
 * Registers the ArkTS half of the `ScannerView` Fabric component.
 *
 * Fabric gets the component's descriptor from the C++ side (generated by
 * `codegen-harmony` and registered in `AppPackage.h`); this package tells RNOH
 * which ArkUI builder draws it, keyed by the component name the JS spec uses.
 */
import { ComponentBuilderContext, RNOHPackage } from '@rnoh/react-native-openharmony/ets';
import { ScannerView } from '../generated/components/ScannerView';
import { buildScannerView } from './ScannerPreview';

export class ScannerViewPackage extends RNOHPackage {
  createWrappedCustomRNComponentBuilderByComponentNameMap(): Map<
    string,
    WrappedBuilder<[ComponentBuilderContext]>
  > {
    return new Map<string, WrappedBuilder<[ComponentBuilderContext]>>([
      [ScannerView.NAME, wrapBuilder(buildScannerView)],
    ]);
  }
}
