{
  "app": {
    // Keep signing material out of git. scripts/inject-signing.py copies the
    // machine-local block in for a build, and the (not yet wired) CI job does
    // the same on the runner.
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // RNOH 0.72.140 was built for the HarmonyOS 5.0 (API 12) runtime. It
        // also runs on newer devices, so target the next LTS line while keeping
        // the minimum at the runtime RNOH was tested against.
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
