# The Podfile for React Native 0.86.
#
# The previous one was the 0.72 template: it configured Flipper and passed
# `get_default_flags()` into `use_react_native!`. Flipper is gone from React
# Native (0.74 removed it) and the flags hash no longer exists, so that file
# could not even resolve when `pod install` ran on this toolchain.
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'KmpPlaygroundRn' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'KmpPlaygroundRnTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # React Native 0.86 ships prebuilt folly headers without `folly/coro/`, while
    # `folly/Expected.h` includes `folly/coro/Coroutine.h` whenever coroutines are
    # available — with C++20 that is always, so every target that touches folly
    # died with 「'folly/coro/Coroutine.h' file not found」. folly's own switch turns
    # the feature off; defining it in the header itself covers pods and the app
    # target alike, without overriding anyone's compiler flags (an earlier attempt
    # set GCC_PREPROCESSOR_DEFINITIONS and silently dropped DEBUG=1).
    # Xcode 27 refuses pods that still declare an old deployment target; the
    # podspecs in these libraries go back to iOS 11/12.
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
    end
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
      end
    end

    # The same header exists four times under Pods (public/private header maps
    # plus the xcframework copy the compiler actually reads), so patch them all.
    folly_headers = Dir.glob(File.join(installer.sandbox.root.to_s, '**/folly/Portability.h'))
    Pod::UI.puts "Patching #{folly_headers.size} folly header(s) for FOLLY_CFG_NO_COROUTINES"
    folly_headers.each do |portability|
      header = File.read(portability)
      # The guard line `#if defined(FOLLY_CFG_NO_COROUTINES)` already contains the
      # name, so look for the definition itself or every file is skipped.
      next if header.include?('#define FOLLY_CFG_NO_COROUTINES 1')
      File.write(portability, "#define FOLLY_CFG_NO_COROUTINES 1\n" + header)
    end
  end
end
