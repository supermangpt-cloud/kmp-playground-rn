{
  "name": "KmpPlaygroundRn",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:demo-html": "node scripts/build-demo-html.js",
    "dev": "react-native bundle --platform harmony --dev true --entry-file index.js --bundle-output harmony/entry/src/main/resources/rawfile/bundle.harmony.js --assets-dest harmony/entry/src/main/resources/rawfile/assets",
    "bundle-harmony": "react-native bundle --platform harmony --dev false --entry-file index.js --bundle-output harmony/entry/src/main/resources/rawfile/bundle.harmony.js --assets-dest harmony/entry/src/main/resources/rawfile/assets",
    "postinstall": "node scripts/patch-rn-webview-android.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-clipboard/clipboard": "1.13.2",
    "@react-native-oh-tpl/async-storage": "1.21.0-0.2.2",
    "@react-native-oh-tpl/clipboard": "1.13.2-0.0.9",
    "@react-native-oh-tpl/react-native-image-picker": "7.0.3-0.1.7",
    "@react-native-oh-tpl/react-native-webview": "13.10.3",
    "@react-native-oh/react-native-harmony": "0.86.1",
    "jpeg-js": "0.4.4",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-image-picker": "7.0.3",
    "react-native-webview": "13.10.2",
    "upng-js": "2.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/cli": "^21.0.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/jest-preset": "^0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^19.1.1",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.4.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=16"
  }
}
